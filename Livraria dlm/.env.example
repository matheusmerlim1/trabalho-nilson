# DLM Bookstore - Configuração do Ambiente
# Copie este arquivo para .env e preencha os valores

# ─── Blockchain ────────────────────────────────────────────
# URL do nó RPC (ex: Infura, Alchemy, ou nó local Hardhat)
RPC_URL=https://sepolia.infura.io/v3/SEU_PROJECT_ID

# Chave privada da carteira ADMINISTRADORA da livraria
# ⚠️ NUNCA commite esta chave no Git!
ADMIN_PRIVATE_KEY=0xSUA_CHAVE_PRIVADA_AQUI

# Endereço do contrato DLMBookstore após deploy
CONTRACT_ADDRESS=0xENDERECO_DO_CONTRATO_AQUI

# ─── API ───────────────────────────────────────────────────
# Chave de API do servidor (protege endpoints admin)
DLM_API_KEY=sua-chave-secreta-api-aqui

# Segredo para assinar tokens JWT
JWT_SECRET=seu-segredo-jwt-super-secreto-aqui

# Porta do servidor
PORT=3001

# ─── DLM PDF API (criptografia centralizada v3) ────────────
# URL da DLM PDF API. Padrão local: http://localhost:3000/api/v1
DRM_API_URL=http://localhost:3000/api/v1
